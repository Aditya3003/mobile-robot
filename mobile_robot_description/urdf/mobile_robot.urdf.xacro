<?xml version="1.0"?>
<robot name="mobile_robot" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- ===== PROPERTIES ===== -->
  <!-- Base (chassis) -->
  <xacro:property name="base_length" value="0.5"/>     <!-- x -->
  <xacro:property name="base_width"  value="0.35"/>    <!-- y -->
  <xacro:property name="base_height" value="0.15"/>    <!-- z -->
  <xacro:property name="base_mass"   value="5.0"/>
  <xacro:property name="base_offset" value="0.025"/>   <!-- chassis center above the wheel axle -->

  <!-- Drive wheels (rear) -->
  <xacro:property name="wheel_radius"     value="0.08"/>
  <xacro:property name="wheel_width"      value="0.05"/>
  <xacro:property name="wheel_mass"       value="0.5"/>
  <xacro:property name="wheel_separation" value="0.4"/>   <!-- left-right, center to center -->
  <xacro:property name="wheel_x"          value="-0.15"/> <!-- rear axle position -->

  <!-- Caster (front) -->
  <xacro:property name="caster_radius" value="0.04"/>
  <xacro:property name="caster_mass"   value="0.2"/>
  <xacro:property name="caster_x"      value="0.18"/>

  <!-- Sensor mast and lidar -->
  <xacro:property name="mast_radius"  value="0.02"/>
  <xacro:property name="mast_height"  value="0.1"/>
  <xacro:property name="lidar_radius" value="0.04"/>
  <xacro:property name="lidar_height" value="0.04"/>

  <!-- ===== MATERIALS ===== -->
  <material name="blue">
    <color rgba="0.1 0.3 0.8 1"/>
  </material>
  <material name="black">
    <color rgba="0.05 0.05 0.05 1"/>
  </material>
  <material name="grey">
    <color rgba="0.6 0.6 0.6 1"/>
  </material>

  <!-- ===== INERTIA MACROS ===== -->
  <xacro:macro name="inertial_box" params="mass x y z xyz">
    <inertial>
      <origin xyz="${xyz}" rpy="0 0 0"/>
      <mass value="${mass}"/>
      <inertia ixx="${mass*(y*y+z*z)/12}" ixy="0" ixz="0"
               iyy="${mass*(x*x+z*z)/12}" iyz="0"
               izz="${mass*(x*x+y*y)/12}"/>
    </inertial>
  </xacro:macro>

  <xacro:macro name="inertial_sphere" params="mass r xyz">
    <inertial>
      <origin xyz="${xyz}" rpy="0 0 0"/>
      <mass value="${mass}"/>
      <inertia ixx="${2*mass*r*r/5}" ixy="0" ixz="0"
               iyy="${2*mass*r*r/5}" iyz="0"
               izz="${2*mass*r*r/5}"/>
    </inertial>
  </xacro:macro>

  <!-- Wheel inertia: a cylinder whose axis lies along y (the axle) -->
  <xacro:macro name="inertial_wheel" params="mass r h">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="${mass}"/>
      <inertia ixx="${mass*(3*r*r+h*h)/12}" ixy="0" ixz="0"
               iyy="${mass*r*r/2}" iyz="0"
               izz="${mass*(3*r*r+h*h)/12}"/>
    </inertial>
  </xacro:macro>

  <!-- ===== WHEEL MACRO. reflect = 1 for left, -1 for right ===== -->
  <xacro:macro name="wheel" params="side reflect">
    <link name="${side}_wheel">
      <visual>
        <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
        </geometry>
        <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>   <!-- turn the cylinder so its axis lies along y -->
        <material name="black"/>
      </visual>
      <collision>
        <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
        </geometry>
        <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
      </collision>
      <xacro:inertial_wheel mass="${wheel_mass}" r="${wheel_radius}" h="${wheel_width}"/>
    </link>

    <!-- Same orientation and axis for both sides: positive rotation drives both wheels forward -->
    <joint name="${side}_wheel_joint" type="continuous">
      <parent link="base_link"/>
      <child link="${side}_wheel"/>
      <origin xyz="${wheel_x} ${reflect*wheel_separation/2} 0" rpy="0 0 0"/>
      <axis xyz="0 1 0"/>
    </joint>

    <!-- Grip on the ground -->
    <gazebo reference="${side}_wheel">
      <mu1>1.0</mu1>
      <mu2>1.0</mu2>
    </gazebo>
  </xacro:macro>

  <!-- ===== ROBOT ===== -->
  <!-- base_footprint: on the ground, below the robot's center. Navigation uses this as the robot's position -->
  <link name="base_footprint"/>

  <!-- base_link: at the height of the wheel axle -->
  <link name="base_link">
    <visual>
      <geometry>
        <box size="${base_length} ${base_width} ${base_height}"/>
      </geometry>
      <origin xyz="0 0 ${base_offset}" rpy="0 0 0"/>
      <material name="blue"/>
    </visual>
    <collision>
      <geometry>
        <box size="${base_length} ${base_width} ${base_height}"/>
      </geometry>
      <origin xyz="0 0 ${base_offset}" rpy="0 0 0"/>
    </collision>
    <xacro:inertial_box mass="${base_mass}" x="${base_length}" y="${base_width}" z="${base_height}" xyz="0 0 ${base_offset}"/>
  </link>

  <joint name="base_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 ${wheel_radius}" rpy="0 0 0"/>
  </joint>

  <!-- Rear drive wheels -->
  <xacro:wheel side="left"  reflect="1"/>
  <xacro:wheel side="right" reflect="-1"/>

  <!-- Front caster: a ball that slides freely in every direction -->
  <link name="caster">
    <visual>
      <geometry>
        <sphere radius="${caster_radius}"/>
      </geometry>
      <material name="grey"/>
    </visual>
    <collision>
      <geometry>
        <sphere radius="${caster_radius}"/>
      </geometry>
    </collision>
    <xacro:inertial_sphere mass="${caster_mass}" r="${caster_radius}" xyz="0 0 0"/>
  </link>

  <!-- Placed so the ball touches the ground, like the wheels -->
  <joint name="caster_joint" type="fixed">
    <parent link="base_link"/>
    <child link="caster"/>
    <origin xyz="${caster_x} 0 ${caster_radius - wheel_radius}" rpy="0 0 0"/>
  </joint>

  <!-- No friction, so the caster never resists turning -->
  <gazebo reference="caster">
    <mu1>0.0</mu1>
    <mu2>0.0</mu2>
  </gazebo>

  <!-- Sensor mast: lifts the lidar above the chassis so it doesn't see the robot itself -->
  <link name="mast">
    <visual>
      <geometry>
        <cylinder radius="${mast_radius}" length="${mast_height}"/>
      </geometry>
      <material name="grey"/>
    </visual>
    <collision>
      <geometry>
        <cylinder radius="${mast_radius}" length="${mast_height}"/>
      </geometry>
    </collision>
    <xacro:inertial_sphere mass="0.1" r="${mast_radius}" xyz="0 0 0"/>
  </link>

  <joint name="mast_joint" type="fixed">
    <parent link="base_link"/>
    <child link="mast"/>
    <origin xyz="0 0 ${base_offset + base_height/2 + mast_height/2}" rpy="0 0 0"/>
  </joint>

  <!-- Lidar body on top of the mast -->
  <link name="lidar_link">
    <visual>
      <geometry>
        <cylinder radius="${lidar_radius}" length="${lidar_height}"/>
      </geometry>
      <material name="black"/>
    </visual>
    <collision>
      <geometry>
        <cylinder radius="${lidar_radius}" length="${lidar_height}"/>
      </geometry>
    </collision>
    <xacro:inertial_sphere mass="0.2" r="${lidar_radius}" xyz="0 0 0"/>
  </link>

  <joint name="lidar_joint" type="fixed">
    <parent link="mast"/>
    <child link="lidar_link"/>
    <origin xyz="0 0 ${mast_height/2 + lidar_height/2}" rpy="0 0 0"/>
  </joint>

  <!-- ===== LIDAR SENSOR ===== -->
  <gazebo reference="lidar_link">
    <sensor name="lidar" type="gpu_lidar">
      <pose>0 0 0 0 0 0</pose>
      <topic>scan</topic>
      <gz_frame_id>lidar_link</gz_frame_id>
      <update_rate>10</update_rate>
      <always_on>true</always_on>
      <visualize>true</visualize>
      <lidar>
        <scan>
          <horizontal>
            <samples>360</samples>
            <resolution>1</resolution>
            <min_angle>-3.14159</min_angle>
            <max_angle>3.14159</max_angle>
          </horizontal>
        </scan>
        <range>
          <min>0.12</min>
          <max>12.0</max>
          <resolution>0.01</resolution>
        </range>
      </lidar>
    </sensor>
  </gazebo>

  <!-- ===== DEPTH CAMERA ===== -->
  <!-- Camera body on the front face of the chassis, facing forward -->
  <link name="camera_link">
    <visual>
      <geometry>
        <box size="0.02 0.08 0.03"/>
      </geometry>
      <material name="black"/>
    </visual>
  </link>

  <joint name="camera_joint" type="fixed">
    <parent link="base_link"/>
    <child link="camera_link"/>
    <origin xyz="${base_length/2 + 0.01} 0 ${base_offset}" rpy="0 0 0"/>
  </joint>

  <!-- Optical frame (z forward, x right, y down), for image-based tools later -->
  <link name="camera_link_optical"/>

  <joint name="camera_optical_joint" type="fixed">
    <parent link="camera_link"/>
    <child link="camera_link_optical"/>
    <origin xyz="0 0 0" rpy="${-pi/2} 0 ${-pi/2}"/>
  </joint>

  <gazebo reference="camera_link">
    <sensor name="depth_camera" type="rgbd_camera">
      <pose>0 0 0 0 0 0</pose>
      <topic>depth_camera</topic>
      <gz_frame_id>camera_link</gz_frame_id>
      <update_rate>10</update_rate>
      <always_on>true</always_on>
      <visualize>true</visualize>
      <camera>
        <horizontal_fov>1.35</horizontal_fov>
        <image>
          <width>640</width>
          <height>480</height>
          <format>R8G8B8</format>
        </image>
        <clip>
          <near>0.05</near>
          <far>10</far>
        </clip>
        <depth_camera>
          <clip>
            <near>0.1</near>
            <far>10</far>
          </clip>
        </depth_camera>
      </camera>
    </sensor>
  </gazebo>

  <!-- ===== DRIVING AND JOINT STATES (Gazebo systems) ===== -->
  <gazebo>
    <!-- Diff drive: takes velocity commands, drives the wheels, publishes odometry and the odom -> base_footprint transform -->
    <plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive">
      <left_joint>left_wheel_joint</left_joint>
      <right_joint>right_wheel_joint</right_joint>
      <wheel_separation>${wheel_separation}</wheel_separation>
      <wheel_radius>${wheel_radius}</wheel_radius>
      <max_linear_acceleration>1.0</max_linear_acceleration>
      <topic>cmd_vel</topic>
      <odom_topic>odom</odom_topic>
      <tf_topic>tf</tf_topic>
      <frame_id>odom</frame_id>
      <child_frame_id>base_footprint</child_frame_id>
      <odom_publisher_frequency>30</odom_publisher_frequency>
    </plugin>

    <!-- Joint states: publishes the wheel positions, so robot_state_publisher can show the wheels turning -->
    <plugin filename="gz-sim-joint-state-publisher-system" name="gz::sim::systems::JointStatePublisher">
      <topic>joint_states</topic>
    </plugin>
  </gazebo>

  <gazebo>
    <plugin filename="gz_ros2_control-system" name="gz_ros2_control::GazeboSimROS2ControlPlugin"/>
  </gazebo>

</robot>